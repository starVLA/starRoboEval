{
  "schema_version": "starvla-rsi.model-config/v1",
  "profile_id": "gpt6_astra",
  "control_method": "codex-native/v2",
  "transport": "codex-app-server/v1",
  "model": "gpt-6-astra",
  "provider": "openai",
  "reasoning_effort": "xhigh",

  "history": "persistent_same_episode_thread",
  "timeout_s": 900,
  "max_chunk_length": 5,
  "ordinary_give_up": false,
  "safety_stop": false,
  "allow_task_completion": false,
  "stagnation_review": false,
  "stagnation_window": 4,
  "policy_stop_rule_version": "minimum-action-decisions/v2",
  "min_action_decisions_before_give_up": 0,

  "max_image_pixels": 4194304,
  "image_max_edge": 480,
  "max_response_bytes": 65536,
  "execution_history_decisions": 8,
  "feedback_projection": "acknowledged_counters_and_actions_plus_declared_robot_state",
  "initial_state_reference": "first_public_observation_not_action",

  "completed_turn_continuations": 2,
  "network_continuations": 20,
  "network_backoff_s": 10,
  "terminal_delivery": "cancel_without_continuation"
}
