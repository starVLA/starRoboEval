{
  "schema_version": "starvla-rsi.configuration-schema/v1",
  "profile_id": "gpt6_astra",
  "execution": "direct",
  "runtime_preflight": true,
  "fields": {
    "schema_version": {
      "type": "string",
      "const": "starvla-rsi.model-config/v1"
    },
    "profile_id": {
      "type": "string",
      "const": "gpt6_astra"
    },
    "control_method": {
      "type": "string",
      "const": "codex-native/v2"
    },
    "transport": {
      "type": "string",
      "const": "codex-app-server/v1"
    },
    "model": {
      "type": "string",
      "const": "gpt-6-astra"
    },
    "provider": {
      "type": "string",
      "const": "openai"
    },
    "reasoning_effort": {
      "type": "string",
      "const": "xhigh"
    },
    "history": {
      "type": "string",
      "const": "persistent_same_episode_thread"
    },
    "timeout_s": {
      "type": "number",
