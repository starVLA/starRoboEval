    "max_image_pixels": {
      "type": "integer",
      "const": 4194304
    },
    "image_max_edge": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "max_response_bytes": {
      "type": "integer",
      "const": 65536
    },
    "execution_history_decisions": {
      "type": "integer",
      "const": 8
    },
    "feedback_projection": {
      "type": "string",
      "const": "acknowledged_counters_and_actions_plus_declared_robot_state"
    },
