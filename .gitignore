# Runtime source, usage guides and protocol data stay tracked.
# Local check/test files and development scratch files are excluded below.
# Inspect actual matches with: git status --short --ignored
# Explain one path with:      git check-ignore -v -- path/to/generated/file
# Ignore rules do not delete local files or untrack files already in Git.

# 1. Python build products and caches (at any package depth)
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# 2. Repository-local working notes, backups and old output locations
/project_readmes/
/barks/
/results/
# Named scratch areas are optional; never blanket-ignore benchkit/ or a policy.
/benchkit/_local/
# Existing ignored scratch/rollouts are historical data, not import aliases.
/harness/_local/
/examples/simBenchmarks/*/rollouts/*
!/examples/simBenchmarks/*/rollouts/README.md
/AgentPolicies/*/_local/
# Retained local development notes; current usage belongs in the profile README.
/AgentPolicies/gpt6_astra/docs/NATIVE_CONTROL.md
# Generated opaque policy endpoints, not unrelated public assets.
/public/mbx-*/

# 3. Method-owned evaluation outputs stay local, including reports and indices.
# Publish selected summaries in project documentation or the website.
/AgentPolicies/*/results/

# 4. Runtime directories and logs, wherever a local command creates them
runs/
logs/
artifacts/
wire/
*.log
*.out

# 5. Legacy benchmark-side rollouts and large generated model/data files
# Preserve the rollout README; new evaluations use AgentPolicies/<method>/results/.
/benchmarks/simBenchmarks/*/rollouts/*
!/benchmarks/simBenchmarks/*/rollouts/README.md
*.mp4
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.parquet

# 6. Local benchmark assets, environments and scratch space
**/bar/
tmp/
temp/
cache/
data/

# 7. Credentials and machine-local environment configuration
.env
.env.*
!.env.example
*.pem
*_token
*_api_key
.hf_token
.wandb_api_key

# 8. Editors and operating systems
.idea/
.vscode/
.DS_Store
*.swp
**/results/*
Projects_readmes

# Local checks and debug files stay outside the tracked project.
**/checks/
**/tests/
**/test_*
**/check_*
**/run_test_*.sh
